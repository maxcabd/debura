# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# Required to run `debura analyze` (headless Ghidra).
GHIDRA_INSTALL_DIR=

# Required for a real AgentProvider (OpenAI). Not needed for the mock
# provider used by `analyze`/`investigate`/`challenge`/`resolve`/`run`.
OPENAI_API_KEY=

# Optional: overrides where project data is stored (default: ~/.debura).
# DEBURA_HOME=
